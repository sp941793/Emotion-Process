<!DOCTYPE html><html lang="en"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8"><link rel="stylesheet" type="text/css" href="cid:css-07d5c379-36d5-4ce5-95dc-a009b1973f63@mhtml.blink" />

<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Process</title>
<link rel="preconnect" href="https://fonts.googleapis.com/">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&amp;family=Work+Sans:wght@400;500;600&amp;display=swap" rel="stylesheet">

</head>
<body>
<div class="orb orb-1"></div>
<div class="orb orb-2"></div>
<div class="orb orb-3"></div>
<div class="wrap">

  <!-- HOME -->
  <div id="home" class="screen active">
    <h1>Process</h1>
    <p class="subhead">Notice it, feel it, get it out, see what it's telling you.</p>

    <div class="home-card">
      <h2>Start a new entry</h2>
      <p>Seven steps, one feeling at a time. No pressure to finish in one sitting.</p>
      <button class="btn-primary btn-full">Begin</button>
    </div>

    <div class="home-card">
      <h2>Past entries</h2>
      <div id="entry-list"><p class="empty-note">No entries yet.</p></div>
      <button class="link-btn" style="margin-top:10px;">See patterns across entries →</button>
    </div>
  </div>

  <!-- SETTLE -->
  <div id="settle" class="screen">
    <div class="top-row">
      <button class="back-link">← Cancel</button>
    </div>
    <div class="settle-circle"></div>
    <p class="settle-text">Get quiet for a moment.<br>Let your attention settle before the words come.</p>
    <button class="btn-primary btn-full">I'm ready</button>
  </div>

  <!-- PATTERNS -->
  <div id="patterns" class="screen">
    <div class="top-row">
      <button class="back-link">← Home</button>
    </div>
    <h1>Patterns</h1>
    <p class="subhead">What you've been feeling, across entries — one story rarely proves a pattern. Repetition does.</p>
    <div id="pattern-list"></div>
  </div>

  <!-- STAGE FLOW -->
  <div id="flow" class="screen">
    <div class="top-row">
      <button class="back-link">← Save &amp; exit</button>
    </div>
    <div class="dots" id="dots"></div>
    <div class="breathe-wrap"><div class="breathe"></div></div>
    <div class="stage-label" id="stage-label"></div>
    <p class="stage-q" id="stage-q"></p>
    <p class="hint" id="stage-hint"></p>
    <textarea id="stage-input" placeholder="Write whatever comes..."></textarea>
    <div class="nav-row">
      <button class="btn-ghost" id="btn-back">Back</button>
      <button class="btn-primary" id="btn-next">Next</button>
    </div>
  </div>

  <!-- SUMMARY -->
  <div id="summary" class="screen">
    <div class="top-row">
      <button class="back-link">← Home</button>
    </div>
    <h1>Your entry</h1>
    <p class="subhead" id="summary-date"></p>
    <div id="summary-content"></div>
    <p class="hint" style="margin-top:4px;">Before you go — one thing you're grateful to yourself for, even here.</p>
    <button class="btn-ghost btn-full" style="margin-top:8px;">Done</button>
  </div>

</div>




</body></html>
