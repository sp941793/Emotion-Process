@charset "utf-8";

:root { --paper: #0B0A10; --ink: #F5F0F7; --ink-soft: #9E8FAE; --line: #2E2438; --accent: #EC1E82; --accent-bg: #3A1229; --warm: #B565F0; --warm-bg: #2A1640; --card: #161220; --glow: 0 0 24px rgba(236,30,130,0.18); }

* { box-sizing: border-box; }

body { margin: 0px; background: var(--paper); color: var(--ink); font-family: "Work Sans", sans-serif; -webkit-font-smoothing: antialiased; overflow-x: hidden; position: relative; }

.orb { position: fixed; border-radius: 50%; filter: blur(70px); opacity: 0.35; pointer-events: none; z-index: 0; }

.orb-1 { width: 340px; height: 340px; background: var(--accent); top: -120px; left: -100px; animation: 18s ease-in-out 0s infinite normal none running drift1; }

.orb-2 { width: 300px; height: 300px; background: var(--warm); bottom: -100px; right: -90px; animation: 22s ease-in-out 0s infinite normal none running drift2; }

.orb-3 { width: 200px; height: 200px; background: var(--accent); top: 40%; right: -80px; opacity: 0.2; animation: 26s ease-in-out 0s infinite normal none running drift3; }

@keyframes drift1 { 
  0%, 100% { transform: translate(0px, 0px) scale(1); }
  50% { transform: translate(40px, 60px) scale(1.15); }
}

@keyframes drift2 { 
  0%, 100% { transform: translate(0px, 0px) scale(1); }
  50% { transform: translate(-30px, -40px) scale(1.1); }
}

@keyframes drift3 { 
  0%, 100% { transform: translate(0px, 0px); }
  50% { transform: translate(-50px, 30px); }
}

.wrap { max-width: 560px; margin: 0px auto; padding: 24px 18px 60px; position: relative; z-index: 1; }

h1 { font-family: Fraunces, serif; font-weight: 600; font-size: 1.6rem; margin: 0px 0px 4px; background-image: ; background-position-x: ; background-position-y: ; background-size: ; background-repeat: ; background-attachment: ; background-origin: ; background-color: ; background-clip: text; -webkit-text-fill-color: transparent; display: inline-block; }

.subhead { color: var(--ink-soft); font-size: 0.92rem; margin: 0px 0px 20px; line-height: 1.4; }

.screen { display: none; animation: 0.35s ease 0s 1 normal none running fadeIn; }

.screen.active { display: block; }

@keyframes fadeIn { 
  0% { opacity: 0; transform: translateY(6px); }
  100% { opacity: 1; transform: translateY(0px); }
}

.dots { display: flex; gap: 6px; margin-bottom: 18px; }

.dot { width: 8px; height: 8px; border-radius: 50%; background: var(--line); transition: background 0.2s; }

.dot.done { background: var(--accent); }

.dot.current { background: var(--warm); box-shadow: 0 0 8px var(--warm); }

.stage-label { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--warm); font-weight: 600; margin-bottom: 6px; }

.stage-q { font-family: Fraunces, serif; font-weight: 600; font-size: 1.25rem; line-height: 1.3; margin: 0px 0px 14px; }

textarea { width: 100%; min-height: 150px; border: 1px solid var(--line); border-radius: 10px; padding: 14px; font-family: "Work Sans", sans-serif; font-size: 0.98rem; line-height: 1.5; background: var(--card); color: var(--ink); resize: vertical; }

textarea:focus { outline: 2px solid var(--accent); box-shadow: 0 0 0 4px var(--accent-bg); }

.nav-row { display: flex; justify-content: space-between; margin-top: 18px; gap: 10px; }

button { font-family: "Work Sans", sans-serif; font-size: 0.92rem; font-weight: 600; border-radius: 8px; padding: 11px 18px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; cursor: pointer; }

.btn-primary { background: var(--accent); color: rgb(255, 255, 255); box-shadow: var(--glow); }

.btn-primary:active { opacity: 0.85; }

.btn-ghost { background: none; color: var(--warm); border: 1px solid var(--line); }

.btn-ghost:active { opacity: 0.7; }

.btn-full { width: 100%; }

.home-card { background: rgba(22, 18, 32, 0.6); backdrop-filter: blur(16px); border: 1px solid var(--line); border-radius: 12px; padding: 18px; margin-bottom: 14px; box-shadow: rgba(0, 0, 0, 0.4) 0px 4px 24px; }

.home-card h2 { font-family: Fraunces, serif; font-weight: 600; font-size: 1.1rem; margin: 0px 0px 6px; }

.home-card p { color: var(--ink-soft); font-size: 0.9rem; margin: 0px 0px 14px; line-height: 1.45; }

.entry-row { background: rgba(22, 18, 32, 0.6); backdrop-filter: blur(12px); border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; margin-bottom: 8px; cursor: pointer; transition: border-color 0.2s; }

.entry-row:active { border-color: var(--accent); }

.entry-date { font-size: 0.8rem; color: var(--ink-soft); }

.entry-preview { font-size: 0.92rem; margin-top: 3px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.summary-block { background: rgba(22, 18, 32, 0.6); backdrop-filter: blur(16px); border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; margin-bottom: 12px; }

.summary-label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--warm); font-weight: 600; margin-bottom: 5px; }

.summary-text { font-size: 0.95rem; line-height: 1.5; white-space: pre-wrap; }

.summary-text.empty { color: var(--ink-soft); font-style: italic; }

.top-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }

.back-link { color: var(--ink-soft); font-size: 0.9rem; cursor: pointer; background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 0px; }

.empty-note { color: var(--ink-soft); font-size: 0.9rem; text-align: center; padding: 20px 0px; }

.hint { font-size: 0.85rem; color: var(--ink-soft); font-style: italic; margin: -8px 0px 14px; line-height: 1.4; }

.settle-circle { width: 110px; height: 110px; margin: 30px auto 26px; border-radius: 50%; background: radial-gradient(circle, var(--accent), var(--warm)); animation: 5s ease-in-out 0s infinite normal none running breathe; box-shadow: rgba(236, 30, 130, 0.4) 0px 0px 50px; }

.settle-text { text-align: center; color: var(--ink-soft); font-size: 0.95rem; margin-bottom: 28px; line-height: 1.5; }

.pattern-row { background: rgba(22, 18, 32, 0.6); backdrop-filter: blur(12px); border-top-color: ; border-top-style: ; border-top-width: ; border-right-color: ; border-right-style: ; border-right-width: ; border-bottom-color: ; border-bottom-style: ; border-bottom-width: ; border-image-source: ; border-image-slice: ; border-image-width: ; border-image-outset: ; border-image-repeat: ; border-left: 3px solid var(--accent); border-radius: 0px 10px 10px 0px; padding: 10px 14px; margin-bottom: 8px; }

.pattern-date { font-size: 0.75rem; color: var(--warm); margin-bottom: 2px; }

.pattern-text { font-size: 0.92rem; line-height: 1.4; }

.link-btn { background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; color: var(--warm); font-size: 0.85rem; font-weight: 600; cursor: pointer; padding: 0px; }

.breathe-wrap { display: flex; justify-content: center; margin: 6px 0px 20px; }

.breathe { width: 56px; height: 56px; border-radius: 50%; background: radial-gradient(circle, var(--accent), var(--warm)); opacity: 0.75; animation: 6s ease-in-out 0s infinite normal none running breathe; box-shadow: rgba(236, 30, 130, 0.35) 0px 0px 30px; }

@keyframes breathe { 
  0%, 100% { transform: scale(0.85); opacity: 0.55; }
